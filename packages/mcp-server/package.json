{
  "name": "dodopayments-mcp",
  "version": "2.54.2",
  "description": "The official MCP Server for the Dodo Payments API",
  "author": "Dodo Payments <support@dodopayments.com>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodopayments/dodopayments-typescript.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/dodopayments/dodopayments-typescript/tree/main/packages/mcp-server#readme",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "build": "bash ./build",
    "prepack": "echo 'to pack, run pnpm build && (cd dist; pnpm pack)' && exit 1",
    "prepublishOnly": "echo 'to publish, run pnpm build && (cd dist; pnpm publish)' && exit 1",
    "format": "prettier --write --cache --cache-strategy metadata . !dist",
    "tsn": "ts-node -r tsconfig-paths/register",
    "lint": "eslint .",
    "fix": "eslint --fix ."
  },
  "dependencies": {
    "dodopayments": "workspace:*",
    "ajv": "^8.20.0",
    "@cloudflare/cabidela": "^0.2.4",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "@valtown/deno-http-worker": "^0.0.21",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "minisearch": "^7.2.0",
    "jq-web": "https://github.com/stainless-api/jq-web/releases/download/v0.8.8/jq-web.tar.gz",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "qs": "^6.16.0",
    "typescript": "5.9.3",
    "yargs": "^18.2.0",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/qs": "^6.14.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.5.0",
    "tsc-multi": "https://github.com/stainless-api/tsc-multi/releases/download/v1.1.11/tsc-multi.tgz",
    "tsconfig-paths": "^4.0.0"
  },
  "imports": {
    "dodopayments-mcp": ".",
    "dodopayments-mcp/*": "./src/*"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./*.mjs": "./dist/*.mjs",
    "./*.js": "./dist/*.js",
    "./*": {
      "require": "./dist/*.js",
      "default": "./dist/*.mjs"
    }
  }
}
