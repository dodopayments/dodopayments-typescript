/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodopayments-api-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // The stateless Worker has no Durable Object. v2 deletes MyMCP and its session storage.
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1",
    },
    {
      "deleted_classes": ["MyMCP"],
      "tag": "v2",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": { "directory": "./static/", "binding": "ASSETS" },
  "alias": {
    "@valtown/deno-http-worker": "./src/stubs/deno-http-worker.ts",
  },
}
