/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodopayments-api-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // dodo-knowledge (Pinecone guide search) for the `search_docs` tool. Same Cloudflare account.
  "services": [{ "binding": "KNOWLEDGE", "service": "dodo-knowledge-mcp" }],
  // The `feedback` tool stores feedback in Sentinel. MCP_FEEDBACK_SECRET is a Worker secret.
  "vars": { "MCP_FEEDBACK_URL": "https://sentinal.dodopayments.com/api/public/mcp-feedback" },
  // 10 `feedback` calls a minute per business and user.
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  // The stateless Worker has no Durable Object. v2 deletes MyMCP and its session storage.
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1",
    },
    {
      "deleted_classes": ["MyMCP"],
      "tag": "v2",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": { "directory": "./static/", "binding": "ASSETS" },
  "alias": {
    "@valtown/deno-http-worker": "./src/stubs/deno-http-worker.ts",
  },
}
