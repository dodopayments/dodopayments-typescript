# ==============================================================================
# Dodo Payments TypeScript SDK — Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual `.env` file or sensitive credentials to version control.
# ==============================================================================

# Dodo Payments API Key (Bearer token for API authorization)
# Required unless passed directly to the DodoPayments constructor:
#   const client = new DodoPayments({ bearerToken: '...' });
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here

# Dodo Payments Webhook Secret Key
# Required for verifying incoming webhook signatures in server handlers:
#   client.webhooks.unwrap(body, headers, secret);
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key_here

# Dodo Payments Base URL Override
# Optional: defaults to "https://live.dodopayments.com" (or test mode "https://test.dodopayments.com")
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com

# SDK Logging Level
# Optional: controls debug/diagnostic log verbosity.
# Supported values: "off" | "error" | "warn" | "info" | "debug" (defaults to "warn")
# DODO_PAYMENTS_LOG=warn

# Mock / Integration Test Server Base URL
# Optional: used by unit and resource integration test suites
# TEST_API_BASE_URL=http://127.0.0.1:4010
