#!/usr/bin/env bash

set -euo pipefail

# This script determines which Docker tags to use based on the version
# It outputs a newline-separated list of tags

# Get version from mcp-server package.json
if [ -f "packages/mcp-server/package.json" ]; then
  VERSION="$(jq -r -e '.version' ./packages/mcp-server/package.json)"
else
  echo "ERROR: Could not determine version from packages/mcp-server/package.json" >&2
  exit 1
fi

# Check if current version is pre-release (e.g. alpha / beta / rc)
CURRENT_IS_PRERELEASE=false
PRERELEASE_TAG=""
if [[ "$VERSION" =~ -([a-zA-Z]+) ]]; then
  CURRENT_IS_PRERELEASE=true
  PRERELEASE_TAG="${BASH_REMATCH[1]}"
fi

# Released stable versions come from this repo's vX.Y.Z git tags (the image is
# published once per release). The GHCR package is private, so probing the
# registry anonymously always saw nothing and every build was treated as newest.
STABLE_VERSIONS="$(git ls-remote --tags --refs origin 'refs/tags/v*' 2>/dev/null \
  | sed -n 's#.*refs/tags/v##p' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V || true)"
HAS_STABLE_RELEASE=false
if [ -n "$STABLE_VERSIONS" ]; then
  HAS_STABLE_RELEASE=true
fi

# True when VERSION is the highest stable version matching the regex $1, so a
# moving tag (latest / MAJOR / MAJOR.MINOR) never goes backwards when an older
# release line is (re)published.
is_newest() {
  local newest
  # shellcheck disable=SC2086 # intentional word-splitting of the version list
  newest="$(printf '%s\n' "$VERSION" $STABLE_VERSIONS | grep -E "$1" | sort -V | tail -1)"
  [ "$newest" = "$VERSION" ]
}

# Output tags based on the logic (matching npm):
# 1. Always output the exact version tag
echo "$VERSION"

# 2. Use pre-release tag (alpha/beta) if there's already a stable release and we're publishing a pre-release
# Otherwise use 'latest', but only for the newest stable version
if $CURRENT_IS_PRERELEASE && $HAS_STABLE_RELEASE; then
  # Only tag with pre-release type, not latest
  echo "$PRERELEASE_TAG"
elif $CURRENT_IS_PRERELEASE; then
  # A pre-release with no stable release yet is the newest thing published
  echo "latest"
elif [[ "$VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  MAJOR="${BASH_REMATCH[1]}"
  MINOR="${BASH_REMATCH[2]}"
  if is_newest '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "latest"
  fi
  if is_newest "^${MAJOR}\.[0-9]+\.[0-9]+$"; then
    echo "$MAJOR"
  fi
  if is_newest "^${MAJOR}\.${MINOR}\.[0-9]+$"; then
    echo "$MAJOR.$MINOR"
  fi
fi
